# Supabase (produção) — sem estas vars o app usa auth mock em localStorage
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Auth mock (dev) — padrão quando Supabase não está configurado
# VITE_AUTH_MOCK=true
# Conta @gm.dev recebe acesso ao /studio.html
# VITE_MOCK_STUDIO=true
# localStorage (dev): game2d_mock_accounts (hash PBKDF2), game2d_mock_session,
# game2d_mock_characters (personagens + posição/mapId/direction)

# Game WebSocket
VITE_GAME_SERVER_WS=ws://localhost:8787
# VITE_GAME_SERVER_WS=false

# Ticket WS (mesmo segredo no server: ENTER_TICKET_SECRET)
# VITE_ENTER_TICKET_SECRET=change-me

# Studio: exigir login GM em dev
# VITE_STUDIO_GUARD=true

# Analytics (console.log eventos)
# VITE_ANALYTICS=true
